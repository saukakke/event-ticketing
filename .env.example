DATABASE_URL="postgresql://postgres:password@localhost:5432/event_ticketing"
JWT_SECRET="replace-with-a-minimum-32-character-random-secret"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:10000"
# The frontend proxies /api requests to BACKEND_URL. No public backend URL is required in browser code.
NODE_ENV="development"

# Paystack: use the test or live secret from your Paystack Dashboard. Never commit a real secret.
PAYSTACK_SECRET_KEY="sk_test_replace-with-your-paystack-secret"

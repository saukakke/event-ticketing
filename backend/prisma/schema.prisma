generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  VOID
}

enum RefundStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model User {
  id                String      @id @default(cuid())
  name              String
  email             String      @unique
  passwordHash      String
  role              UserRole    @default(ATTENDEE)
  suspendedAt       DateTime?
  suspensionReason  String?
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  events            Event[]     @relation("OrganizerEvents")
  orders            Order[]
  auditLogs         AuditLog[]
  refundsRequested  Refund[]    @relation("RefundRequestedBy")

  @@index([role])
  @@index([role, suspendedAt])
  @@index([deletedAt])
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String
  venue       String
  city        String
  startAt     DateTime
  endAt       DateTime
  status      EventStatus @default(DRAFT)
  organizerId String
  organizer   User        @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Restrict)
  ticketTypes TicketType[]
  orders      Order[]
  tickets     Ticket[]
  refunds     Refund[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([organizerId, status])
  @@index([startAt, status])
}

model TicketType {
  id          String      @id @default(cuid())
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priceKobo   Int
  capacity    Int
  soldCount   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  tickets     Ticket[]

  @@index([eventId])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  eventId           String
  status            OrderStatus @default(PENDING)
  totalKobo         Int
  currency          String      @default("NGN")
  paystackReference String?     @unique
  paymentMetadata   Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  event             Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  tickets           Ticket[]
  refunds           Refund[]

  @@index([userId, status])
  @@index([eventId, status])
  @@index([status, createdAt])
}

model OrderItem {
  id           String     @id @default(cuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPriceKobo Int
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([ticketTypeId])
}

model Ticket {
  id           String       @id @default(cuid())
  code         String       @unique
  qrToken      String       @unique
  qrCodeDataUrl String
  status       TicketStatus @default(ACTIVE)
  checkedIn    Boolean      @default(false)
  checkedInAt  DateTime?
  orderId      String
  eventId      String
  ticketTypeId String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([eventId, status])
  @@index([ticketTypeId])
  @@index([checkedIn])
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  eventId         String
  requestedById   String
  amountKobo      Int
  currency        String       @default("NGN")
  status          RefundStatus @default(PENDING)
  reason          String?
  providerReference String?
  providerResponse Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  requestedBy     User         @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([eventId, status])
  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entity, entityId, createdAt])
  @@index([action, createdAt])
}
